# CivicResolve AI — Environment Variables
# Copy this file to .env and fill in values.

# ── Backend API ───────────────────────────────────────────────────────────────
# URL of the FastAPI backend. When set, complaints are stored in civic.db.
# Leave empty to run in demo/localStorage mode.
VITE_API_BASE_URL=http://localhost:8000

# ── App Settings ─────────────────────────────────────────────────────────────
VITE_APP_NAME=CivicResolve AI
VITE_APP_VERSION=1.0.0
VITE_DEMO_MODE=true

# ── Backend only (set in backend/.env or shell, NOT in this file) ─────────────
# JWT_SECRET_KEY=your-secure-random-secret-here
# ADMIN_EMAIL=admin@civicresolve.ai
# ADMIN_PASSWORD=admin123
