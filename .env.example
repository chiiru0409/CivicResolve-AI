# CivicResolve AI — Environment Variables Reference

# ── Backend Configuration (Optional / Defaults provided in code) ──
# JWT secret key for signing tokens (Change in production)
JWT_SECRET_KEY=civicresolve-prod-jwt-secret-key-change-this

# Allowed CORS origins (comma-separated). Leave unset to auto-allow localhost & Vercel domains
# CORS_ORIGINS=https://your-project.vercel.app,http://localhost:5173

# Optional Local / Remote Ollama AI LLM configuration
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b

# Default seed admin credentials (Created automatically if not existing)
ADMIN_EMAIL=admin@civicresolve.ai
ADMIN_PASSWORD=Admin@123456

# ── Frontend Configuration ──
# Backend API Base URL. Leave empty for same-origin Vercel deployment, or set if hosted on separate URL
# VITE_API_BASE_URL=
