{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/docs",
      "destination": "/api"
    },
    {
      "source": "/openapi.json",
      "destination": "/api"
    },
    {
      "source": "/health",
      "destination": "/api"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api"
    },
    {
      "source": "/complaints/(.*)",
      "destination": "/api"
    },
    {
      "source": "/complaints",
      "destination": "/api"
    },
    {
      "source": "/voice/(.*)",
      "destination": "/api"
    },
    {
      "source": "/track/(.*)",
      "destination": "/api"
    },
    {
      "source": "/chat",
      "destination": "/api"
    },
    {
      "source": "/departments/(.*)",
      "destination": "/api"
    },
    {
      "source": "/departments",
      "destination": "/api"
    },
    {
      "source": "/public/(.*)",
      "destination": "/api"
    },
    {
      "source": "/admin/ai/(.*)",
      "destination": "/api"
    },
    {
      "source": "/admin/complaints/(.*)",
      "destination": "/api"
    },
    {
      "source": "/admin/analytics",
      "destination": "/api"
    },
    {
      "source": "/admin/map/(.*)",
      "destination": "/api"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
